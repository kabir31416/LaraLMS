# SPA fallback for LiteSpeed/Apache hosting (mod_rewrite) — without this,
# any hard refresh or direct visit to a client-side route (e.g. /marksheet,
# /info, /students) is requested from the server as a literal file path,
# which doesn't exist on disk, so the server 404s before React Router ever
# gets a chance to run. This rewrites every request that isn't a real file
# or directory back to index.html so the SPA can take over routing.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
