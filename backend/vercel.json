{
  "version": 2,
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.ts"
    }
  ],
  "crons": [
    {
      "path": "/api/v1/sms/cron/birthday",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/v1/mess/cron/monthly-billing",
      "schedule": "5 18 * * *"
    }
  ]
}
