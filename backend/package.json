{
  "name": "laralms-backend",
  "version": "1.0.0",
  "private": true,
  "description": "LaraLMS Coaching Management ERP — backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "seed": "ts-node-dev --transpile-only src/scripts/seed.ts",
    "check-login": "ts-node-dev --transpile-only src/scripts/check-login.ts",
    "list-logins": "ts-node-dev --transpile-only src/scripts/list-student-logins.ts",
    "check-setup": "ts-node-dev --transpile-only src/scripts/check-setup.ts",
    "migrate:global-subjects": "ts-node-dev --transpile-only src/scripts/migrate-global-subjects.ts",
    "migrate:hsc-ssc-group": "ts-node-dev --transpile-only src/scripts/migrate-hsc-ssc-group.ts",
    "audit:students": "ts-node-dev --transpile-only src/scripts/audit-student-data.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.15.0",
    "pino": "^9.3.2",
    "pino-http": "^10.2.0",
    "tesseract.js": "^7.0.0",
    "uuid": "^10.0.0",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^22.5.0",
    "@types/pdfkit": "^0.13.4",
    "@types/uuid": "^10.0.0",
    "pino-pretty": "^11.2.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
