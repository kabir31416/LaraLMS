PORT=5000
NODE_ENV=development

MONGO_URI=mongodb://127.0.0.1:27017/laralms

JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
# Student/Staff Portal logins (phone + Roll Number / Staff ID) have no
# refresh cookie at all, so their access token has to just last the session
# instead of silently renewing — 12h covers a normal working/school day.
PORTAL_ACCESS_EXPIRES_IN=12h
# Public Student Entry (/studententry) verification token lifetime — just
# long enough to complete one profile/photo update in a single visit.
STUDENT_ENTRY_TOKEN_EXPIRES_IN=15m

CORS_ORIGIN=http://localhost:5173

# Student photo storage (Student Photo Management). Create a free Cloudinary
# account, then copy these three values from its Dashboard. Leave blank in
# development and photo upload endpoints will fail with a clear error —
# every other feature keeps working. NEVER commit real values here.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

BCRYPT_SALT_ROUNDS=12

# Used only by `npm run seed` to create the first Admin user
ADMIN_SEED_PHONE=01700000000
ADMIN_SEED_PASSWORD=ChangeMe123!
ADMIN_SEED_NAME=Admin

# BulkSMSBD (or compatible) gateway — used to text a Student's login
# credential (mobile + Roll Number) whenever their login is created or
# reset. Leave blank to disable SMS sending (it will just log and skip).
# NEVER commit real values here — set them only in your local .env.
SMS_API_KEY=
SMS_SENDER_ID=
SMS_API_URL=http://bulksmsbd.net/api/smsapi

# Closing signature line on the Result Entry guardian SMS (e.g. "Neuron Coaching.") — your own centre's name, not a gateway credential.
SMS_SIGNATURE=LaraLMS
